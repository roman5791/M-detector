<?xml version="1.0"?>
<package format="3">
  <name>m_detector</name>
  <version>0.0.0</version>

  <description>
    This is a implemented version of M-detector which is original algorithm
    is described in the following paper:
        Moving Event Detection from LiDAR Point Streams.
  </description>

  <maintainer email="wu2020@connect.hku.hk">HuajieWu</maintainer>
  
  <license>GNUv2</license>

  <author email="wu2020@connect.hku.hk">HuajieWu</author>
  <author email="yhangli@connect.hku.hk">YihangLi</author>
  
  <!-- ROS1 buildtool -->
  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  
  <!-- ROS2 buildtool -->
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  
  <!-- Common dependencies for both ROS1 and ROS2 -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  
  <!-- ROS1 specific -->
  <build_depend condition="$ROS_VERSION == 1">roscpp</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rospy</build_depend>
  <build_depend condition="$ROS_VERSION == 1">tf</build_depend>
  <build_depend condition="$ROS_VERSION == 1">pcl_ros</build_depend>
  <build_depend condition="$ROS_VERSION == 1">livox_ros_driver</build_depend>
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>
  <build_depend condition="$ROS_VERSION == 1">eigen_conversions</build_depend>
  
  <run_depend condition="$ROS_VERSION == 1">roscpp</run_depend>
  <run_depend condition="$ROS_VERSION == 1">rospy</run_depend>
  <run_depend condition="$ROS_VERSION == 1">tf</run_depend>
  <run_depend condition="$ROS_VERSION == 1">pcl_ros</run_depend>
  <run_depend condition="$ROS_VERSION == 1">livox_ros_driver</run_depend>
  <run_depend condition="$ROS_VERSION == 1">message_runtime</run_depend>
  
  <!-- ROS2 specific -->
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">tf2</depend>
  <depend condition="$ROS_VERSION == 2">tf2_eigen</depend>
  <depend condition="$ROS_VERSION == 2">tf2_geometry_msgs</depend>
  <depend condition="$ROS_VERSION == 2">pcl_ros</depend>
  <depend condition="$ROS_VERSION == 2">pcl_conversions</depend>
  
  <!-- Test dependencies for ROS1 -->
  <test_depend condition="$ROS_VERSION == 1">rostest</test_depend>
  <test_depend condition="$ROS_VERSION == 1">rosbag</test_depend>

  <export>
  </export>
</package>
